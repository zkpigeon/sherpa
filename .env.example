# Three different random tokens, such as the output of: openssl rand -hex 24
# Agents use the agent token, runners the runner token, and you the admin
# token, which is also the dashboard's password.
SHERPA_AGENT_TOKEN=
SHERPA_RUNNER_TOKEN=
SHERPA_ADMIN_TOKEN=

# Where sherpa-server listens on the host. Agents on this machine use
# http://127.0.0.1:8080. To reach it from other machines, put it behind a TLS
# proxy and bind 0.0.0.0.
SHERPA_BIND=127.0.0.1
SHERPA_PORT=8080

# Module time limits in minutes. Extensions come on top of the ceiling.
SHERPA_DEFAULT_MAX_MINUTES=90
SHERPA_MAX_MINUTES_CEILING=120

# The runner. Labels say what hardware it has (cpu, gpu). SHERPA_REPO is the
# remote for projects that don't name one; SHERPA_REPOS is a host folder of bare
# repos, mounted at /repos. SHERPA_CPUSET pins benchmarks to cores, such as 2-5.
SHERPA_RUNNER_NAME=runner-1
SHERPA_LABELS=cpu
SHERPA_REPO=
SHERPA_REPOS=./repos
SHERPA_CPUSET=
SHERPA_MEMORY=
